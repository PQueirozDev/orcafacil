# Copie para .env.local e preencha. As duas chaves abaixo são PÚBLICAS (vão para o navegador).
# Nunca coloque aqui a service role key nem a senha do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: mostra o botão "Entrar com Google" (exige configurar o provedor no Supabase)
VITE_LOGIN_GOOGLE=false
